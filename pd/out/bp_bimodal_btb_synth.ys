# Yosys synthesis script for IHP sg13g2. FILES/TOP/OUT/LIBERTY are substituted by the Makefile
# (sed) before this is run, since plain yosys script syntax (not -c/tcl mode) has no env-var
# substitution. read_verilog -sv ../rtl/bp/bp_bimodal_btb.sv expands to one read_verilog line per file in blocks.mk's FILES_<block>.

read_verilog -sv ../rtl/bp/bp_bimodal_btb.sv

hierarchy -top bp_bimodal_btb
synth -top bp_bimodal_btb

dfflibmap -liberty /home/bomma/pdk/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib
abc -liberty /home/bomma/pdk/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib

opt_clean

stat -liberty /home/bomma/pdk/IHP-Open-PDK/ihp-sg13g2/libs.ref/sg13g2_stdcell/lib/sg13g2_stdcell_typ_1p20V_25C.lib

write_verilog -noattr out/bp_bimodal_btb_syn.v
write_json out/bp_bimodal_btb_syn.json
