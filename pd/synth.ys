# Yosys synthesis script for IHP sg13g2. TOP/OUT/LIBERTY are substituted by the Makefile (sed) before
# this is run, since plain yosys script syntax (not -c/tcl mode) has no env-var substitution.

read_verilog -sv ../rtl/alu.sv
read_verilog -sv ../rtl/muldiv.sv
read_verilog -sv ../rtl/regfile.sv
read_verilog -sv ../rtl/decode.sv
read_verilog -sv ../rtl/core.sv

hierarchy -top @TOP@
synth -top @TOP@

dfflibmap -liberty @LIBERTY@
abc -liberty @LIBERTY@

opt_clean

stat -liberty @LIBERTY@

write_verilog -noattr @OUT@.v
write_json @OUT@.json
